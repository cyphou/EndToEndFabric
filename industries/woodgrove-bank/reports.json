    {
      "name": "WoodgroveBank-HTAP",
      "theme": {
        "primary": "#003087",
        "secondary": "#FFB819",
        "background": "#FAFAFA"
      },
      "pages": [
        {
          "name": "Real-Time Transactions",
          "visuals": [
            {
              "type": "card",
              "measure": "Transaction Count"
            },
            {
              "type": "card",
              "measure": "Total Transaction Volume"
            },
            {
              "type": "lineChart",
              "axis": "Timestamp",
              "values": [
                "Amount"
              ],
              "streaming": true
            },
            {
              "type": "map",
              "location": "DimBranches[State]",
              "color": "Transaction Count"
            }
          ]
        },
        {
          "name": "Fraud Detection",
          "visuals": [
            {
              "type": "card",
              "measure": "Fraud Alert Count"
            },
            {
              "type": "card",
              "measure": "Avg Fraud Risk Score"
            },
            {
              "type": "clusteredBarChart",
              "axis": "AlertType",
              "values": [
                "AlertCount"
              ]
            },
            {
              "type": "table",
              "columns": [
                "AlertType",
                "LatestTimestamp",
                "AlertCount",
                "AvgRiskScore"
              ]
            }
          ]
        },
        {
          "name": "ATM Monitoring",
          "visuals": [
            {
              "type": "card",
              "measure": "ATM Branches %"
            },
            {
              "type": "lineChart",
              "axis": "Timestamp",
              "values": [
                "CashLevel"
              ],
              "streaming": true
            },
            {
              "type": "table",
              "columns": [
                "ATMID",
                "Location",
                "CashLevel",
                "Status",
                "LastTransaction"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "WoodgroveBank-Pipeline",
      "theme": {
        "primary": "#003087",
        "secondary": "#FFB819",
        "background": "#FAFAFA"
      },
      "pages": [
        {
          "name": "Pipeline Overview",
          "visuals": [
            {
              "type": "card",
              "measure": "Total Tables Loaded"
            },
            {
              "type": "card",
              "measure": "Total Rows Ingested"
            },
            {
              "type": "card",
              "measure": "Last Refresh Time"
            },
            {
              "type": "card",
              "measure": "Pipeline Success Rate"
            },
            {
              "type": "clusteredBarChart",
              "axis": "Domain",
              "values": [
                "Tables Loaded",
                "Rows Ingested"
              ]
            },
            {
              "type": "table",
              "columns": [
                "Pipeline Step",
                "Status",
                "Duration (s)",
                "Rows Processed"
              ]
            }
          ]
        },
        {
          "name": "Data Quality",
          "visuals": [
            {
              "type": "card",
              "measure": "Data Quality Score"
            },
            {
              "type": "card",
              "measure": "Null Value Count"
            },
            {
              "type": "card",
              "measure": "Duplicate Row Count"
            },
            {
              "type": "clusteredBarChart",
              "axis": "TableName",
              "values": [
                "Null %",
                "Duplicate %"
              ]
            },
            {
              "type": "table",
              "columns": [
                "TableName",
                "TotalRows",
                "NullCount",
                "DuplicateCount",
                "QualityScore"
              ]
            }
          ]
        },
        {
          "name": "Refresh History",
          "visuals": [
            {
              "type": "lineChart",
              "axis": "RefreshDate",
              "values": [
                "Duration (s)",
                "Rows Processed"
              ]
            },
            {
              "type": "table",
              "columns": [
                "RefreshDate",
                "Pipeline",
                "Status",
                "Duration (s)",
                "Error"
              ]
            }
          ]
        },
        {
          "name": "Ingestion by Domain",
          "visuals": [
            {
              "type": "donutChart",
              "legend": "Domain",
              "values": [
                "Rows Ingested"
              ]
            },
            {
              "type": "stackedBarChart",
              "axis": "Domain",
              "values": [
                "CSV Files",
                "Tables Created"
              ]
            },
            {
              "type": "table",
              "columns": [
                "Domain",
                "Dataflow",
                "CSV Files",
                "Tables",
                "Last Run"
              ]
            }
          ]
        }
      ]
    },
    {
