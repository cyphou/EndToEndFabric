      { "fromTable": "FactReadmissions", "fromColumn": "PatientID", "toTable": "DimPatients", "toColumn": "PatientID", "cardinality": "ManyToOne", "isActive": false },
      { "fromTable": "FactReadmissions", "fromColumn": "ReadmitDate", "toTable": "DimDate", "toColumn": "Date", "cardinality": "ManyToOne", "isActive": false },
      { "fromTable": "FactPreventiveCare", "fromColumn": "PatientID", "toTable": "DimPatients", "toColumn": "PatientID", "cardinality": "ManyToOne", "isActive": false },
      { "fromTable": "FactPreventiveCare", "fromColumn": "MeasureDate", "toTable": "DimDate", "toColumn": "Date", "cardinality": "ManyToOne", "isActive": false }
    ],
    "measures": [
      { "name": "Total Encounters", "table": "FactEncounters", "expression": "COUNTROWS(FactEncounters)", "formatString": "#,0", "displayFolder": "Clinical" },
      { "name": "Total Patients", "table": "DimPatients", "expression": "COUNTROWS(DimPatients)", "formatString": "#,0", "displayFolder": "Clinical" },
      { "name": "Active Patients", "table": "DimPatients", "expression": "CALCULATE(COUNTROWS(DimPatients), DimPatients[IsActive] = TRUE())", "formatString": "#,0", "displayFolder": "Clinical" },
      { "name": "Unique Patients Seen", "table": "FactEncounters", "expression": "DISTINCTCOUNT(FactEncounters[PatientID])", "formatString": "#,0", "displayFolder": "Clinical" },
      { "name": "Avg Length of Stay", "table": "FactEncounters", "expression": "AVERAGE(FactEncounters[LengthOfStayDays])", "formatString": "0.0", "displayFolder": "Clinical" },
      { "name": "Inpatient LOS", "table": "FactEncounters", "expression": "CALCULATE(AVERAGE(FactEncounters[LengthOfStayDays]), FactEncounters[EncounterType] = \"Inpatient\")", "formatString": "0.0", "displayFolder": "Clinical" },
      { "name": "ED Encounters", "table": "FactEncounters", "expression": "CALCULATE(COUNTROWS(FactEncounters), FactEncounters[EncounterType] = \"Emergency\")", "formatString": "#,0", "displayFolder": "Clinical" },
      { "name": "Inpatient Encounters", "table": "FactEncounters", "expression": "CALCULATE(COUNTROWS(FactEncounters), FactEncounters[EncounterType] = \"Inpatient\")", "formatString": "#,0", "displayFolder": "Clinical" },
      { "name": "Outpatient Encounters", "table": "FactEncounters", "expression": "CALCULATE(COUNTROWS(FactEncounters), FactEncounters[EncounterType] = \"Outpatient\")", "formatString": "#,0", "displayFolder": "Clinical" },
      { "name": "Telehealth Encounters", "table": "FactEncounters", "expression": "CALCULATE(COUNTROWS(FactEncounters), FactEncounters[EncounterType] = \"Telehealth\")", "formatString": "#,0", "displayFolder": "Clinical" },
      { "name": "Avg Patient Satisfaction", "table": "FactEncounters", "expression": "AVERAGE(FactEncounters[PatientSatisfactionScore])", "formatString": "0.00", "displayFolder": "Clinical" },
      { "name": "Mortality Rate", "table": "FactEncounters", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactEncounters), FactEncounters[DischargeDisposition] = \"Expired\"), COUNTROWS(FactEncounters))", "formatString": "0.00%", "displayFolder": "Clinical" },
      { "name": "AMA Rate", "table": "FactEncounters", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactEncounters), FactEncounters[DischargeDisposition] = \"AMA\"), COUNTROWS(FactEncounters))", "formatString": "0.00%", "displayFolder": "Clinical" },
      { "name": "Patient Volume YoY", "table": "FactEncounters", "expression": "VAR _CY = COUNTROWS(FactEncounters) VAR _PY = CALCULATE(COUNTROWS(FactEncounters), DATEADD(DimDate[Date], -1, YEAR)) RETURN DIVIDE(_CY - _PY, _PY)", "formatString": "0.0%", "displayFolder": "Clinical" },
      { "name": "Encounter MoM Change", "table": "FactEncounters", "expression": "VAR _CM = COUNTROWS(FactEncounters) VAR _PM = CALCULATE(COUNTROWS(FactEncounters), DATEADD(DimDate[Date], -1, MONTH)) RETURN _CM - _PM", "formatString": "#,0", "displayFolder": "Clinical" },
      { "name": "Avg Charges per Encounter", "table": "FactEncounters", "expression": "AVERAGE(FactEncounters[TotalCharges])", "formatString": "$#,0", "displayFolder": "Clinical" },
      { "name": "Total Lab Results", "table": "FactLabResults", "expression": "COUNTROWS(FactLabResults)", "formatString": "#,0", "displayFolder": "Clinical" },
      { "name": "Abnormal Lab Rate", "table": "FactLabResults", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactLabResults), FactLabResults[IsAbnormal] = TRUE()), COUNTROWS(FactLabResults))", "formatString": "0.0%", "displayFolder": "Clinical" },
      { "name": "Critical Lab Rate", "table": "FactLabResults", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactLabResults), FactLabResults[IsCritical] = TRUE()), COUNTROWS(FactLabResults))", "formatString": "0.0%", "displayFolder": "Clinical" },
      { "name": "Avg Lab Turnaround (min)", "table": "FactLabResults", "expression": "AVERAGE(FactLabResults[TurnaroundMinutes])", "formatString": "#,0", "displayFolder": "Clinical" },
      { "name": "Avg Heart Rate", "table": "FactVitalSigns", "expression": "AVERAGE(FactVitalSigns[HeartRate])", "formatString": "0", "displayFolder": "Clinical" },
      { "name": "Avg Systolic BP", "table": "FactVitalSigns", "expression": "AVERAGE(FactVitalSigns[SystolicBP])", "formatString": "0", "displayFolder": "Clinical" },
      { "name": "Avg SpO2", "table": "FactVitalSigns", "expression": "AVERAGE(FactVitalSigns[SpO2])", "formatString": "0.0%", "displayFolder": "Clinical" },
      { "name": "Avg Pain Score", "table": "FactVitalSigns", "expression": "AVERAGE(FactVitalSigns[PainScore])", "formatString": "0.0", "displayFolder": "Clinical" },
      { "name": "Total Charges", "table": "FactClaims", "expression": "SUM(FactClaims[ChargedAmount])", "formatString": "$#,0;($#,0)", "displayFolder": "Revenue Cycle" },
      { "name": "Total Allowed", "table": "FactClaims", "expression": "SUM(FactClaims[AllowedAmount])", "formatString": "$#,0;($#,0)", "displayFolder": "Revenue Cycle" },
      { "name": "Total Paid", "table": "FactClaims", "expression": "SUM(FactClaims[PaidAmount])", "formatString": "$#,0;($#,0)", "displayFolder": "Revenue Cycle" },
      { "name": "Total Patient Responsibility", "table": "FactClaims", "expression": "SUM(FactClaims[PatientResponsibility])", "formatString": "$#,0;($#,0)", "displayFolder": "Revenue Cycle" },
      { "name": "Collection Rate", "table": "FactClaims", "expression": "DIVIDE(SUM(FactClaims[PaidAmount]), SUM(FactClaims[ChargedAmount]))", "formatString": "0.0%", "displayFolder": "Revenue Cycle" },
      { "name": "Net Collection Rate", "table": "FactClaims", "expression": "DIVIDE(SUM(FactClaims[PaidAmount]), SUM(FactClaims[AllowedAmount]))", "formatString": "0.0%", "displayFolder": "Revenue Cycle" },
      { "name": "Denial Rate", "table": "FactClaims", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactClaims), FactClaims[ClaimStatus] = \"Denied\"), COUNTROWS(FactClaims))", "formatString": "0.0%", "displayFolder": "Revenue Cycle" },
      { "name": "Avg Days to Payment", "table": "FactClaims", "expression": "AVERAGE(FactClaims[DaysToPayment])", "formatString": "0.0", "displayFolder": "Revenue Cycle" },
      { "name": "Revenue per Encounter", "table": "FactClaims", "expression": "DIVIDE(SUM(FactClaims[PaidAmount]), DISTINCTCOUNT(FactClaims[EncounterID]))", "formatString": "$#,0", "displayFolder": "Revenue Cycle" },
      { "name": "Revenue YoY Growth", "table": "FactClaims", "expression": "VAR _CY = SUM(FactClaims[PaidAmount]) VAR _PY = CALCULATE(SUM(FactClaims[PaidAmount]), DATEADD(DimDate[Date], -1, YEAR)) RETURN DIVIDE(_CY - _PY, _PY)", "formatString": "0.0%", "displayFolder": "Revenue Cycle" },
      { "name": "Total Claims", "table": "FactClaims", "expression": "COUNTROWS(FactClaims)", "formatString": "#,0", "displayFolder": "Revenue Cycle" },
      { "name": "Clean Claim Rate", "table": "FactClaims", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactClaims), FactClaims[ClaimStatus] = \"Paid\"), COUNTROWS(FactClaims))", "formatString": "0.0%", "displayFolder": "Revenue Cycle" },
      { "name": "Contractual Adjustment", "table": "FactClaims", "expression": "SUM(FactClaims[ChargedAmount]) - SUM(FactClaims[AllowedAmount])", "formatString": "$#,0;($#,0)", "displayFolder": "Revenue Cycle" },
      { "name": "Total Payments Received", "table": "FactPayments", "expression": "SUM(FactPayments[PaymentAmount])", "formatString": "$#,0;($#,0)", "displayFolder": "Revenue Cycle" },
      { "name": "Total Adjustments", "table": "FactPayments", "expression": "SUM(FactPayments[AdjustmentAmount])", "formatString": "$#,0;($#,0)", "displayFolder": "Revenue Cycle" },
      { "name": "Total Denials", "table": "FactDenials", "expression": "COUNTROWS(FactDenials)", "formatString": "#,0", "displayFolder": "Revenue Cycle" },
      { "name": "Total Denied Amount", "table": "FactDenials", "expression": "SUM(FactDenials[DeniedAmount])", "formatString": "$#,0;($#,0)", "displayFolder": "Revenue Cycle" },
      { "name": "Denial Recovery Rate", "table": "FactDenials", "expression": "DIVIDE(SUM(FactDenials[RecoveredAmount]), SUM(FactDenials[DeniedAmount]))", "formatString": "0.0%", "displayFolder": "Revenue Cycle" },
      { "name": "Appeal Success Rate", "table": "FactDenials", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactDenials), FactDenials[AppealStatus] = \"Appeal Won\"), CALCULATE(COUNTROWS(FactDenials), FactDenials[AppealStatus] IN {\"Appeal Won\", \"Appeal Denied\"}))", "formatString": "0.0%", "displayFolder": "Revenue Cycle" },
      { "name": "Payor Mix Commercial %", "table": "FactClaims", "expression": "DIVIDE(CALCULATE(SUM(FactClaims[PaidAmount]), DimPayors[PayorType] = \"Commercial\"), SUM(FactClaims[PaidAmount]))", "formatString": "0.0%", "displayFolder": "Revenue Cycle" },
      { "name": "Payor Mix Medicare %", "table": "FactClaims", "expression": "DIVIDE(CALCULATE(SUM(FactClaims[PaidAmount]), DimPayors[PayorType] = \"Medicare\"), SUM(FactClaims[PaidAmount]))", "formatString": "0.0%", "displayFolder": "Revenue Cycle" },
      { "name": "Payor Mix Medicaid %", "table": "FactClaims", "expression": "DIVIDE(CALCULATE(SUM(FactClaims[PaidAmount]), DimPayors[PayorType] = \"Medicaid\"), SUM(FactClaims[PaidAmount]))", "formatString": "0.0%", "displayFolder": "Revenue Cycle" },
      { "name": "Total RVUs", "table": "FactClaims", "expression": "SUMX(FactClaims, RELATED(DimCPTCodes[BaseRVU]))", "formatString": "#,0.0", "displayFolder": "Revenue Cycle" },
      { "name": "Bed Occupancy Rate", "table": "FactBedCensus", "expression": "DIVIDE(SUM(FactBedCensus[OccupiedBeds]), SUM(FactBedCensus[OccupiedBeds]) + SUM(FactBedCensus[AvailableBeds]))", "formatString": "0.0%", "displayFolder": "Operations" },
      { "name": "Available Beds", "table": "FactBedCensus", "expression": "SUM(FactBedCensus[AvailableBeds])", "formatString": "#,0", "displayFolder": "Operations" },
      { "name": "Occupied Beds", "table": "FactBedCensus", "expression": "SUM(FactBedCensus[OccupiedBeds])", "formatString": "#,0", "displayFolder": "Operations" },
      { "name": "Pending Discharges", "table": "FactBedCensus", "expression": "SUM(FactBedCensus[PendingDischarges])", "formatString": "#,0", "displayFolder": "Operations" },
      { "name": "Pending Admissions", "table": "FactBedCensus", "expression": "SUM(FactBedCensus[PendingAdmissions])", "formatString": "#,0", "displayFolder": "Operations" },
      { "name": "Total Admissions", "table": "FactAdmissions", "expression": "COUNTROWS(FactAdmissions)", "formatString": "#,0", "displayFolder": "Operations" },
      { "name": "Avg Admission LOS", "table": "FactAdmissions", "expression": "AVERAGE(FactAdmissions[LengthOfStayDays])", "formatString": "0.0", "displayFolder": "Operations" },
      { "name": "Case Mix Index", "table": "FactAdmissions", "expression": "AVERAGE(FactAdmissions[CaseMixIndex])", "formatString": "0.000", "displayFolder": "Operations" },
      { "name": "Emergency Admissions %", "table": "FactAdmissions", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactAdmissions), FactAdmissions[AdmissionPriority] = \"Emergency\"), COUNTROWS(FactAdmissions))", "formatString": "0.0%", "displayFolder": "Operations" },
      { "name": "Elective Admissions %", "table": "FactAdmissions", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactAdmissions), FactAdmissions[AdmissionPriority] = \"Elective\"), COUNTROWS(FactAdmissions))", "formatString": "0.0%", "displayFolder": "Operations" },
      { "name": "Transfer Rate", "table": "FactAdmissions", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactAdmissions), FactAdmissions[AdmissionSource] = \"Transfer\"), COUNTROWS(FactAdmissions))", "formatString": "0.0%", "displayFolder": "Operations" },
      { "name": "Nurse-to-Patient Ratio", "table": "FactStaffing", "expression": "DIVIDE(SUM(FactStaffing[RNCount]), SUM(FactStaffing[PatientCount]))", "formatString": "0.00", "displayFolder": "Operations" },
      { "name": "Total RN Hours", "table": "FactStaffing", "expression": "SUM(FactStaffing[RNCount]) * 8", "formatString": "#,0", "displayFolder": "Operations" },
      { "name": "Overtime Hours", "table": "FactStaffing", "expression": "SUM(FactStaffing[OvertimeHours])", "formatString": "#,0.0", "displayFolder": "Operations" },
      { "name": "Agency Staff %", "table": "FactStaffing", "expression": "DIVIDE(SUM(FactStaffing[AgencyStaffCount]), SUM(FactStaffing[RNCount]) + SUM(FactStaffing[CNACount]) + SUM(FactStaffing[AgencyStaffCount]))", "formatString": "0.0%", "displayFolder": "Operations" },
      { "name": "Staffing Ratio by Shift", "table": "FactStaffing", "expression": "DIVIDE(SUM(FactStaffing[RNCount]) + SUM(FactStaffing[CNACount]), SUM(FactStaffing[PatientCount]))", "formatString": "0.00", "displayFolder": "Operations" },
      { "name": "ICU Occupancy Rate", "table": "FactBedCensus", "expression": "CALCULATE(DIVIDE(SUM(FactBedCensus[OccupiedBeds]), SUM(FactBedCensus[OccupiedBeds]) + SUM(FactBedCensus[AvailableBeds])), FactBedCensus[Unit] = \"ICU\")", "formatString": "0.0%", "displayFolder": "Operations" },
      { "name": "ED Boarding Hours", "table": "FactBedCensus", "expression": "CALCULATE(SUM(FactBedCensus[PendingAdmissions]) * 4, FactBedCensus[Unit] = \"ED Holding\")", "formatString": "#,0", "displayFolder": "Operations" },
      { "name": "Total Prescriptions", "table": "FactPrescriptions", "expression": "COUNTROWS(FactPrescriptions)", "formatString": "#,0", "displayFolder": "Pharmacy" },
      { "name": "Total Rx Cost", "table": "FactPrescriptions", "expression": "SUM(FactPrescriptions[TotalCost])", "formatString": "$#,0;($#,0)", "displayFolder": "Pharmacy" },
      { "name": "Avg Rx Cost", "table": "FactPrescriptions", "expression": "AVERAGE(FactPrescriptions[TotalCost])", "formatString": "$#,0.00", "displayFolder": "Pharmacy" },
      { "name": "Generic Dispensing Rate", "table": "FactPrescriptions", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactPrescriptions), FactPrescriptions[IsGeneric] = TRUE()), COUNTROWS(FactPrescriptions))", "formatString": "0.0%", "displayFolder": "Pharmacy" },
      { "name": "Controlled Substance %", "table": "FactPrescriptions", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactPrescriptions), RELATED(DimMedications[IsControlled]) = TRUE()), COUNTROWS(FactPrescriptions))", "formatString": "0.0%", "displayFolder": "Pharmacy" },
      { "name": "Avg Days Supply", "table": "FactPrescriptions", "expression": "AVERAGE(FactPrescriptions[DaysSupply])", "formatString": "0.0", "displayFolder": "Pharmacy" },
      { "name": "Total Med Administrations", "table": "FactMedicationAdministration", "expression": "COUNTROWS(FactMedicationAdministration)", "formatString": "#,0", "displayFolder": "Pharmacy" },
      { "name": "Med Admin Timeliness", "table": "FactMedicationAdministration", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactMedicationAdministration), FactMedicationAdministration[IsTimely] = TRUE()), COUNTROWS(FactMedicationAdministration))", "formatString": "0.0%", "displayFolder": "Pharmacy" },
      { "name": "Med Given Rate", "table": "FactMedicationAdministration", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactMedicationAdministration), FactMedicationAdministration[AdminStatus] = \"Given\"), COUNTROWS(FactMedicationAdministration))", "formatString": "0.0%", "displayFolder": "Pharmacy" },
      { "name": "Med Held Rate", "table": "FactMedicationAdministration", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactMedicationAdministration), FactMedicationAdministration[AdminStatus] = \"Held\"), COUNTROWS(FactMedicationAdministration))", "formatString": "0.0%", "displayFolder": "Pharmacy" },
      { "name": "Rx per Encounter", "table": "FactPrescriptions", "expression": "DIVIDE(COUNTROWS(FactPrescriptions), DISTINCTCOUNT(FactPrescriptions[EncounterID]))", "formatString": "0.0", "displayFolder": "Pharmacy" },
      { "name": "Pharmacy Spend per Patient", "table": "FactPrescriptions", "expression": "DIVIDE(SUM(FactPrescriptions[TotalCost]), DISTINCTCOUNT(FactPrescriptions[PatientID]))", "formatString": "$#,0", "displayFolder": "Pharmacy" },
      { "name": "Top Drug Class by Cost", "table": "FactPrescriptions", "expression": "MAXX(TOPN(1, SUMMARIZE(FactPrescriptions, DimMedications[DrugClass], \"DrugCost\", SUM(FactPrescriptions[TotalCost])), [DrugCost], DESC), DimMedications[DrugClass])", "formatString": "", "displayFolder": "Pharmacy" },
      { "name": "Avg HCC Score", "table": "FactRiskScores", "expression": "AVERAGE(FactRiskScores[HCCScore])", "formatString": "0.00", "displayFolder": "Population Health" },
      { "name": "Avg Readmission Risk", "table": "FactRiskScores", "expression": "AVERAGE(FactRiskScores[ReadmissionRisk])", "formatString": "0.0%", "displayFolder": "Population Health" },
      { "name": "High Risk Patients", "table": "FactRiskScores", "expression": "CALCULATE(DISTINCTCOUNT(FactRiskScores[PatientID]), FactRiskScores[RiskTier] IN {\"High\", \"Complex\"})", "formatString": "#,0", "displayFolder": "Population Health" },
      { "name": "Avg Chronic Conditions", "table": "FactRiskScores", "expression": "AVERAGE(FactRiskScores[ChronicConditionCount])", "formatString": "0.0", "displayFolder": "Population Health" },
      { "name": "Social Determinant Flag Rate", "table": "FactRiskScores", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactRiskScores), FactRiskScores[SocialDeterminantFlag] = TRUE()), COUNTROWS(FactRiskScores))", "formatString": "0.0%", "displayFolder": "Population Health" },
      { "name": "30-Day Readmission Rate", "table": "FactReadmissions", "expression": "DIVIDE(COUNTROWS(FactReadmissions), CALCULATE(COUNTROWS(FactEncounters), FactEncounters[EncounterType] = \"Inpatient\"))", "formatString": "0.0%", "displayFolder": "Population Health" },
      { "name": "Total Readmissions", "table": "FactReadmissions", "expression": "COUNTROWS(FactReadmissions)", "formatString": "#,0", "displayFolder": "Population Health" },
      { "name": "Preventable Readmission %", "table": "FactReadmissions", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactReadmissions), FactReadmissions[WasPreventable] = TRUE()), COUNTROWS(FactReadmissions))", "formatString": "0.0%", "displayFolder": "Population Health" },
      { "name": "Readmission Penalty Count", "table": "FactReadmissions", "expression": "CALCULATE(COUNTROWS(FactReadmissions), FactReadmissions[PenaltyApplied] = TRUE())", "formatString": "#,0", "displayFolder": "Population Health" },
      { "name": "Avg Days Between Readmit", "table": "FactReadmissions", "expression": "AVERAGE(FactReadmissions[DaysBetween])", "formatString": "0.0", "displayFolder": "Population Health" },
      { "name": "HEDIS Compliance Rate", "table": "FactPreventiveCare", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactPreventiveCare), FactPreventiveCare[IsCompliant] = TRUE()), COUNTROWS(FactPreventiveCare))", "formatString": "0.0%", "displayFolder": "Population Health" },
      { "name": "Total Preventive Screenings", "table": "FactPreventiveCare", "expression": "COUNTROWS(FactPreventiveCare)", "formatString": "#,0", "displayFolder": "Population Health" },
      { "name": "Avg Care Gap Days", "table": "FactPreventiveCare", "expression": "AVERAGE(FactPreventiveCare[GapDays])", "formatString": "#,0", "displayFolder": "Population Health" },
      { "name": "Avg Outreach Attempts", "table": "FactPreventiveCare", "expression": "AVERAGE(FactPreventiveCare[OutreachAttempts])", "formatString": "0.0", "displayFolder": "Population Health" },
      { "name": "Diabetes Screening Rate", "table": "FactPreventiveCare", "expression": "CALCULATE(DIVIDE(CALCULATE(COUNTROWS(FactPreventiveCare), FactPreventiveCare[IsCompliant] = TRUE()), COUNTROWS(FactPreventiveCare)), FactPreventiveCare[HEDISMeasure] = \"CDC-HbA1c\")", "formatString": "0.0%", "displayFolder": "Population Health" },
      { "name": "BP Control Rate", "table": "FactPreventiveCare", "expression": "CALCULATE(DIVIDE(CALCULATE(COUNTROWS(FactPreventiveCare), FactPreventiveCare[IsCompliant] = TRUE()), COUNTROWS(FactPreventiveCare)), FactPreventiveCare[HEDISMeasure] = \"CBP\")", "formatString": "0.0%", "displayFolder": "Population Health" },
      { "name": "Physician Count", "table": "DimPhysicians", "expression": "COUNTROWS(DimPhysicians)", "formatString": "#,0", "displayFolder": "Clinical" },
      { "name": "Active Physicians", "table": "DimPhysicians", "expression": "CALCULATE(COUNTROWS(DimPhysicians), DimPhysicians[CredentialStatus] = \"Active\")", "formatString": "#,0", "displayFolder": "Clinical" },
      { "name": "Facility Count", "table": "DimFacilities", "expression": "COUNTROWS(DimFacilities)", "formatString": "#,0", "displayFolder": "Operations" },
      { "name": "Hospital Count", "table": "DimFacilities", "expression": "CALCULATE(COUNTROWS(DimFacilities), DimFacilities[FacilityType] = \"Hospital\")", "formatString": "#,0", "displayFolder": "Operations" },
      { "name": "Clinic Count", "table": "DimFacilities", "expression": "CALCULATE(COUNTROWS(DimFacilities), DimFacilities[FacilityType] = \"Clinic\")", "formatString": "#,0", "displayFolder": "Operations" },
      { "name": "Total Licensed Beds", "table": "DimFacilities", "expression": "SUM(DimFacilities[LicensedBeds])", "formatString": "#,0", "displayFolder": "Operations" },
      { "name": "Avg CMS Rating", "table": "DimFacilities", "expression": "AVERAGE(DimFacilities[CMSRating])", "formatString": "0.0", "displayFolder": "Operations" }
    ]
  }
}
