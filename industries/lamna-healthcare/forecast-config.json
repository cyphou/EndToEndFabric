{
  "schemaVersion": "1.0",
  "forecastModels": [
    {
      "name": "PatientDemand",
      "description": "Forecast patient encounter volume by encounter type",
      "table": "FactEncounters",
      "dateColumn": "AdmitDate",
      "valueColumn": "EncounterID",
      "groupBy": "EncounterType",
      "algorithm": "HoltWinters",
      "params": {
        "seasonal": "additive",
        "alpha": 0.3,
        "beta": 0.1,
        "gamma": 0.15,
        "seasonalPeriods": 12
      },
      "horizonMonths": 12
    },
    {
      "name": "Revenue",
      "description": "Forecast claim payments for revenue projection",
      "table": "FactClaims",
      "dateColumn": "ServiceDate",
      "valueColumn": "PaidAmount",
      "groupBy": null,
      "algorithm": "HoltWinters",
      "params": {
        "seasonal": "additive",
        "alpha": 0.3,
        "beta": 0.1,
        "gamma": 0.1,
        "seasonalPeriods": 12
      },
      "horizonMonths": 12
    },
    {
      "name": "BedCapacity",
      "description": "Forecast bed occupancy for capacity planning",
      "table": "FactBedCensus",
      "dateColumn": "CensusDate",
      "valueColumn": "OccupiedBeds",
      "groupBy": "FacilityID",
      "algorithm": "HoltWinters",
      "params": {
        "seasonal": "additive",
        "alpha": 0.25,
        "beta": 0.1,
        "gamma": 0.2,
        "seasonalPeriods": 12
      },
      "horizonMonths": 6
    },
    {
      "name": "ReadmissionRisk",
      "description": "Forecast readmission trends for quality improvement",
      "table": "FactReadmissions",
      "dateColumn": "ReadmitDate",
      "valueColumn": "ReadmissionID",
      "groupBy": null,
      "algorithm": "HoltWinters",
      "params": {
        "seasonal": "additive",
        "alpha": 0.2,
        "beta": 0.05,
        "gamma": 0.1,
        "seasonalPeriods": 12
      },
      "horizonMonths": 12
    },
    {
      "name": "PharmaDemand",
      "description": "Forecast pharmaceutical spend and prescription volume",
      "table": "FactPrescriptions",
      "dateColumn": "PrescriptionDate",
      "valueColumn": "TotalCost",
      "groupBy": null,
      "algorithm": "HoltWinters",
      "params": {
        "seasonal": "additive",
        "alpha": 0.3,
        "beta": 0.1,
        "gamma": 0.15,
        "seasonalPeriods": 12
      },
      "horizonMonths": 12
    }
  ],
  "mlflow": {
    "experimentName": "LamnaHealthcare_Forecasting",
    "trackMetrics": [
      "rmse",
      "mae",
      "mape"
    ],
    "logModel": true
  }
}
