{
  "schemaVersion": "1.0",
  "webEnrichment": {
    "enabled": true,
    "targetLakehouse": "SilverLH",
    "schema": "web",
    "sources": [
      {
        "name": "CDCHealthData",
        "description": "CDC community health indicators and disease prevalence by county",
        "endpoint": "https://data.cdc.gov/resource/dxpw-cm5u.json",
        "method": "GET",
        "schedule": "weekly",
        "tableName": "WebCDCHealthData",
        "columns": [
          { "name": "County", "type": "string" },
          { "name": "State", "type": "string" },
          { "name": "MeasureName", "type": "string" },
          { "name": "DataValue", "type": "double" },
          { "name": "YearStart", "type": "int" },
          { "name": "YearEnd", "type": "int" },
          { "name": "Category", "type": "string" },
          { "name": "DataSource", "type": "string" }
        ]
      },
      {
        "name": "CensusPopulation",
        "description": "US Census population estimates by county for service area analysis",
        "endpoint": "https://api.census.gov/data/2023/pep/population",
        "method": "GET",
        "schedule": "monthly",
        "tableName": "WebCensusPopulation",
        "columns": [
          { "name": "County", "type": "string" },
          { "name": "State", "type": "string" },
          { "name": "TotalPopulation", "type": "int" },
          { "name": "MedianAge", "type": "double" },
          { "name": "Over65Pct", "type": "double" },
          { "name": "Under18Pct", "type": "double" },
          { "name": "UninsuredPct", "type": "double" },
          { "name": "ReferenceDate", "type": "date" }
        ]
      },
      {
        "name": "WeatherImpact",
        "description": "Weather forecasts for Pacific Northwest facilities to predict patient volume surges",
        "endpoint": "https://api.open-meteo.com/v1/forecast",
        "method": "GET",
        "schedule": "daily",
        "tableName": "WebWeatherImpact",
        "columns": [
          { "name": "Latitude", "type": "double" },
          { "name": "Longitude", "type": "double" },
          { "name": "ForecastDate", "type": "date" },
          { "name": "TemperatureMaxF", "type": "double" },
          { "name": "TemperatureMinF", "type": "double" },
          { "name": "PrecipitationInch", "type": "double" },
          { "name": "AQI", "type": "int" },
          { "name": "HeatIndex", "type": "double" }
        ]
      }
    ]
  }
}
