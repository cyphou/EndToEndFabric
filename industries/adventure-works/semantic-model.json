      { "name": "Total Taxes", "table": "FactRoomRevenue", "expression": "SUM(FactRoomRevenue[Taxes])", "formatString": "$#,0;($#,0)", "displayFolder": "Revenue" },
      { "name": "Revenue YoY Growth", "table": "FactRoomRevenue", "expression": "VAR _CY = SUM(FactRoomRevenue[TotalRevenue]) VAR _PY = CALCULATE(SUM(FactRoomRevenue[TotalRevenue]), DATEADD(DimDate[Date], -1, YEAR)) RETURN DIVIDE(_CY - _PY, _PY)", "formatString": "0.0%", "displayFolder": "Revenue" },
      { "name": "Revenue MoM Change", "table": "FactRoomRevenue", "expression": "VAR _CM = SUM(FactRoomRevenue[TotalRevenue]) VAR _PM = CALCULATE(SUM(FactRoomRevenue[TotalRevenue]), DATEADD(DimDate[Date], -1, MONTH)) RETURN _CM - _PM", "formatString": "$#,0;($#,0)", "displayFolder": "Revenue" },
      { "name": "Rooms Occupied", "table": "FactRoomRevenue", "expression": "SUM(FactRoomRevenue[RoomsOccupied])", "formatString": "#,0", "displayFolder": "Occupancy" },
      { "name": "Rooms Available", "table": "FactRoomRevenue", "expression": "SUM(FactRoomRevenue[RoomsAvailable])", "formatString": "#,0", "displayFolder": "Occupancy" },
      { "name": "Occupancy Rate", "table": "FactRoomRevenue", "expression": "DIVIDE(SUM(FactRoomRevenue[RoomsOccupied]), SUM(FactRoomRevenue[RoomsAvailable]))", "formatString": "0.0%", "displayFolder": "Occupancy" },
      { "name": "ADR", "table": "FactRoomRevenue", "expression": "DIVIDE(SUM(FactRoomRevenue[TotalRevenue]), SUM(FactRoomRevenue[RoomsOccupied]))", "formatString": "$#,0.00", "displayFolder": "Occupancy" },
      { "name": "RevPAR", "table": "FactRoomRevenue", "expression": "DIVIDE(SUM(FactRoomRevenue[TotalRevenue]), SUM(FactRoomRevenue[RoomsAvailable]))", "formatString": "$#,0.00", "displayFolder": "Occupancy" },
      { "name": "TRevPAR", "table": "FactRoomRevenue", "expression": "DIVIDE(SUM(FactRoomRevenue[TotalRevenue]) + SUM(FactFBRevenue[TotalFBRevenue]) + SUM(FactSpaRevenue[Revenue]) + SUM(FactAdventureRevenue[Revenue]), SUM(FactRoomRevenue[RoomsAvailable]))", "formatString": "$#,0.00", "displayFolder": "Occupancy" },
      { "name": "GOPPAR", "table": "FactRoomRevenue", "expression": "DIVIDE(SUM(FactRoomRevenue[TotalRevenue]) + SUM(FactFBRevenue[TotalFBRevenue]) + SUM(FactSpaRevenue[Revenue]) + SUM(FactAdventureRevenue[Revenue]) - SUM(FactFBRevenue[CostOfGoods]) - SUM(FactAdventureRevenue[EquipmentCost]) - SUM(FactAdventureRevenue[GuideCost]), SUM(FactRoomRevenue[RoomsAvailable]))", "formatString": "$#,0.00", "displayFolder": "Occupancy" },
      { "name": "Occupancy YoY", "table": "FactRoomRevenue", "expression": "VAR _CY = DIVIDE(SUM(FactRoomRevenue[RoomsOccupied]), SUM(FactRoomRevenue[RoomsAvailable])) VAR _PY = CALCULATE(DIVIDE(SUM(FactRoomRevenue[RoomsOccupied]), SUM(FactRoomRevenue[RoomsAvailable])), DATEADD(DimDate[Date], -1, YEAR)) RETURN _CY - _PY", "formatString": "0.0 pp", "displayFolder": "Occupancy" },
      { "name": "ADR YoY Growth", "table": "FactRoomRevenue", "expression": "VAR _CY = DIVIDE(SUM(FactRoomRevenue[TotalRevenue]), SUM(FactRoomRevenue[RoomsOccupied])) VAR _PY = CALCULATE(DIVIDE(SUM(FactRoomRevenue[TotalRevenue]), SUM(FactRoomRevenue[RoomsOccupied])), DATEADD(DimDate[Date], -1, YEAR)) RETURN DIVIDE(_CY - _PY, _PY)", "formatString": "0.0%", "displayFolder": "Occupancy" },
      { "name": "Total Reservations", "table": "FactReservations", "expression": "COUNTROWS(FactReservations)", "formatString": "#,0", "displayFolder": "Reservations" },
