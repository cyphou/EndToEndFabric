      { "name": "Spa Utilization %", "table": "FactSpaRevenue", "expression": "DIVIDE(COUNTROWS(FactSpaRevenue), DISTINCTCOUNT(FactSpaRevenue[TherapistID]) * 6)", "formatString": "0.0%", "displayFolder": "Spa" },
