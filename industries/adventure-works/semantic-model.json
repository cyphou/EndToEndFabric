      { "name": "Early Check-In %", "table": "FactCheckIns", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactCheckIns), FactCheckIns[IsEarlyCheckIn] = TRUE()), COUNTROWS(FactCheckIns))", "formatString": "0.0%", "displayFolder": "Reservations" },
      { "name": "Late Check-Out %", "table": "FactCheckIns", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactCheckIns), FactCheckIns[IsLateCheckOut] = TRUE()), COUNTROWS(FactCheckIns))", "formatString": "0.0%", "displayFolder": "Reservations" },
