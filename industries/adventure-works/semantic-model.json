      { "name": "Adventure Gross Margin", "table": "FactAdventureRevenue", "expression": "DIVIDE(SUM(FactAdventureRevenue[Revenue]) - SUM(FactAdventureRevenue[EquipmentCost]) - SUM(FactAdventureRevenue[GuideCost]), SUM(FactAdventureRevenue[Revenue]))", "formatString": "0.0%", "displayFolder": "Adventures" },
      { "name": "Guide Utilization", "table": "FactGuideSchedules", "expression": "DIVIDE(COUNTROWS(FactGuideSchedules), DISTINCTCOUNT(FactGuideSchedules[StaffID]) * 250)", "formatString": "0.0%", "displayFolder": "Adventures" },
