      { "name": "F&B Cost of Goods", "table": "FactFBRevenue", "expression": "SUM(FactFBRevenue[CostOfGoods])", "formatString": "$#,0;($#,0)", "displayFolder": "F&B" },
      { "name": "F&B Gross Margin %", "table": "FactFBRevenue", "expression": "DIVIDE(SUM(FactFBRevenue[TotalFBRevenue]) - SUM(FactFBRevenue[CostOfGoods]), SUM(FactFBRevenue[TotalFBRevenue]))", "formatString": "0.0%", "displayFolder": "F&B" },
