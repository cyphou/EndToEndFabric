      { "name": "NPS", "table": "FactGuestSurveys", "expression": "VAR _Promoters = CALCULATE(COUNTROWS(FactGuestSurveys), FactGuestSurveys[Score] >= 9) VAR _Detractors = CALCULATE(COUNTROWS(FactGuestSurveys), FactGuestSurveys[Score] <= 6) VAR _Total = COUNTROWS(FactGuestSurveys) RETURN DIVIDE(_Promoters - _Detractors, _Total) * 100", "formatString": "#,0", "displayFolder": "Guest Experience" },
