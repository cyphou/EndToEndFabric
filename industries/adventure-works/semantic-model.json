      { "name": "Rebook Rate", "table": "FactCancellations", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactCancellations), FactCancellations[WasRebooked] = TRUE()), COUNTROWS(FactCancellations))", "formatString": "0.0%", "displayFolder": "Cancellations" },
      { "name": "F&B Revenue per Cover", "table": "FactFBRevenue", "expression": "DIVIDE(SUM(FactFBRevenue[TotalFBRevenue]), SUM(FactFBRevenue[Covers]))", "formatString": "$#,0.00", "displayFolder": "F&B" },
