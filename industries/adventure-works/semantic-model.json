      { "name": "Total Spa Revenue", "table": "FactSpaRevenue", "expression": "SUM(FactSpaRevenue[Revenue])", "formatString": "$#,0;($#,0)", "displayFolder": "Revenue" },
      { "name": "Total Adventure Revenue", "table": "FactAdventureRevenue", "expression": "SUM(FactAdventureRevenue[Revenue])", "formatString": "$#,0;($#,0)", "displayFolder": "Revenue" },
      { "name": "Total Revenue", "table": "FactRoomRevenue", "expression": "SUM(FactRoomRevenue[TotalRevenue]) + SUM(FactFBRevenue[TotalFBRevenue]) + SUM(FactSpaRevenue[Revenue]) + SUM(FactAdventureRevenue[Revenue])", "formatString": "$#,0;($#,0)", "displayFolder": "Revenue" },
