      { "name": "Avg Stay Length", "table": "FactReservations", "expression": "AVERAGE(FactReservations[RoomNights])", "formatString": "0.0", "displayFolder": "Reservations" },
      { "name": "Direct Booking %", "table": "FactReservations", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactReservations), FactReservations[BookingChannel] = \"Direct\"), COUNTROWS(FactReservations))", "formatString": "0.0%", "displayFolder": "Reservations" },
      { "name": "OTA Booking %", "table": "FactReservations", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactReservations), FactReservations[BookingChannel] = \"OTA\"), COUNTROWS(FactReservations))", "formatString": "0.0%", "displayFolder": "Reservations" },
      { "name": "Corporate Booking %", "table": "FactReservations", "expression": "DIVIDE(CALCULATE(COUNTROWS(FactReservations), FactReservations[BookingChannel] = \"Corporate\"), COUNTROWS(FactReservations))", "formatString": "0.0%", "displayFolder": "Reservations" },
