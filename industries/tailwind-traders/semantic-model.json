    "measures": [
      {
        "name": "GMV",
        "table": "FactOnlineOrders",
        "expression": "SUM(FactOnlineOrders[OrderTotal]) + SUM(FactPOSTransactions[SaleAmount])",
        "formatString": "$#,0;($#,0)",
        "displayFolder": "Revenue"
      },
      {
        "name": "Online Revenue",
        "table": "FactOnlineOrders",
        "expression": "SUM(FactOnlineOrders[OrderTotal])",
        "formatString": "$#,0;($#,0)",
        "displayFolder": "Revenue"
      },
      {
        "name": "Store Revenue",
        "table": "FactPOSTransactions",
        "expression": "SUM(FactPOSTransactions[SaleAmount])",
        "formatString": "$#,0;($#,0)",
        "displayFolder": "Revenue"
      },
      {
        "name": "Total Revenue",
        "table": "FactOnlineOrders",
        "expression": "SUM(FactOnlineOrders[OrderTotal]) + SUM(FactPOSTransactions[SaleAmount])",
        "formatString": "$#,0;($#,0)",
        "displayFolder": "Revenue"
      },
      {
        "name": "Revenue YoY Growth",
        "table": "FactOnlineOrders",
        "expression": "VAR _CY = [Total Revenue] VAR _PY = CALCULATE([Total Revenue], DATEADD(DimDate[Date], -1, YEAR)) RETURN DIVIDE(_CY - _PY, _PY)",
        "formatString": "0.0%",
        "displayFolder": "Revenue"
      },
      {
        "name": "Revenue MoM Change",
        "table": "FactOnlineOrders",
        "expression": "VAR _CM = [Total Revenue] VAR _PM = CALCULATE([Total Revenue], DATEADD(DimDate[Date], -1, MONTH)) RETURN _CM - _PM",
        "formatString": "$#,0;($#,0)",
        "displayFolder": "Revenue"
      },
      {
        "name": "AOV",
        "table": "FactOnlineOrders",
        "expression": "DIVIDE(SUM(FactOnlineOrders[OrderTotal]), COUNTROWS(FactOnlineOrders))",
        "formatString": "$#,0.00",
        "displayFolder": "E-Commerce"
      },
      {
        "name": "Online Order Count",
        "table": "FactOnlineOrders",
        "expression": "COUNTROWS(FactOnlineOrders)",
        "formatString": "#,0",
        "displayFolder": "E-Commerce"
      },
      {
        "name": "Total Items Sold Online",
        "table": "FactOrderItems",
        "expression": "SUM(FactOrderItems[Quantity])",
        "formatString": "#,0",
        "displayFolder": "E-Commerce"
      },
      {
        "name": "Avg Items Per Order",
        "table": "FactOrderItems",
        "expression": "DIVIDE(SUM(FactOrderItems[Quantity]), DISTINCTCOUNT(FactOrderItems[OrderID]))",
        "formatString": "0.0",
        "displayFolder": "E-Commerce"
      },
      {
        "name": "Total Shipping Cost",
        "table": "FactOnlineOrders",
        "expression": "SUM(FactOnlineOrders[ShippingCost])",
        "formatString": "$#,0;($#,0)",
        "displayFolder": "E-Commerce"
      },
      {
        "name": "Avg Shipping Cost",
        "table": "FactOnlineOrders",
        "expression": "AVERAGE(FactOnlineOrders[ShippingCost])",
        "formatString": "$#,0.00",
        "displayFolder": "E-Commerce"
      },
      {
        "name": "Total Discounts",
        "table": "FactOnlineOrders",
        "expression": "SUM(FactOnlineOrders[DiscountAmount])",
        "formatString": "$#,0;($#,0)",
        "displayFolder": "E-Commerce"
      },
      {
        "name": "Discount Rate",
        "table": "FactOnlineOrders",
        "expression": "DIVIDE(SUM(FactOnlineOrders[DiscountAmount]), SUM(FactOnlineOrders[OrderTotal]))",
        "formatString": "0.0%",
        "displayFolder": "E-Commerce"
      },
      {
        "name": "Conversion Rate",
        "table": "FactWebTraffic",
        "expression": "AVERAGE(FactWebTraffic[ConversionRate])",
        "formatString": "0.00%",
        "displayFolder": "E-Commerce"
      },
      {
        "name": "Cart Abandonment Rate",
        "table": "FactWebTraffic",
        "expression": "AVERAGE(FactWebTraffic[CartAbandonment])",
        "formatString": "0.0%",
        "displayFolder": "E-Commerce"
      },
      {
        "name": "Total Page Views",
        "table": "FactWebTraffic",
        "expression": "SUM(FactWebTraffic[PageViews])",
        "formatString": "#,0",
        "displayFolder": "E-Commerce"
      },
      {
        "name": "Unique Sessions",
        "table": "FactWebTraffic",
        "expression": "SUM(FactWebTraffic[UniqueSessions])",
        "formatString": "#,0",
        "displayFolder": "E-Commerce"
      },
      {
        "name": "Bounce Rate",
        "table": "FactWebTraffic",
        "expression": "AVERAGE(FactWebTraffic[BounceRate])",
        "formatString": "0.0%",
        "displayFolder": "E-Commerce"
      },
      {
        "name": "Avg Session Duration",
        "table": "FactWebTraffic",
        "expression": "AVERAGE(FactWebTraffic[AvgSessionDuration])",
        "formatString": "#,0",
        "displayFolder": "E-Commerce"
      },
      {
        "name": "Delivered Order %",
        "table": "FactOnlineOrders",
        "expression": "DIVIDE(CALCULATE(COUNTROWS(FactOnlineOrders), FactOnlineOrders[OrderStatus] = \"Delivered\"), COUNTROWS(FactOnlineOrders))",
        "formatString": "0.0%",
        "displayFolder": "E-Commerce"
      },
      {
        "name": "Cancelled Order %",
        "table": "FactOnlineOrders",
        "expression": "DIVIDE(CALCULATE(COUNTROWS(FactOnlineOrders), FactOnlineOrders[OrderStatus] = \"Cancelled\"), COUNTROWS(FactOnlineOrders))",
        "formatString": "0.0%",
        "displayFolder": "E-Commerce"
      },
      {
        "name": "Return Rate",
        "table": "FactReturns",
        "expression": "DIVIDE(COUNTROWS(FactReturns), COUNTROWS(FactOnlineOrders))",
        "formatString": "0.0%",
        "displayFolder": "Returns"
      },
      {
        "name": "Total Refunds",
        "table": "FactReturns",
        "expression": "SUM(FactReturns[RefundAmount])",
        "formatString": "$#,0;($#,0)",
        "displayFolder": "Returns"
      },
      {
        "name": "Avg Refund Amount",
        "table": "FactReturns",
        "expression": "AVERAGE(FactReturns[RefundAmount])",
        "formatString": "$#,0.00",
        "displayFolder": "Returns"
      },
      {
        "name": "Return Count",
        "table": "FactReturns",
        "expression": "COUNTROWS(FactReturns)",
        "formatString": "#,0",
        "displayFolder": "Returns"
      },
      {
        "name": "COGS",
        "table": "FactOrderItems",
        "expression": "SUMX(FactOrderItems, FactOrderItems[Quantity] * RELATED(DimProducts[CostPrice]))",
        "formatString": "$#,0;($#,0)",
        "displayFolder": "Profitability"
      },
      {
        "name": "Gross Profit",
        "table": "FactOrderItems",
        "expression": "[Total Revenue] - [COGS]",
        "formatString": "$#,0;($#,0)",
        "displayFolder": "Profitability"
      },
      {
        "name": "Gross Margin %",
        "table": "FactOrderItems",
        "expression": "DIVIDE([Gross Profit], [Total Revenue])",
        "formatString": "0.0%",
        "displayFolder": "Profitability"
      },
      {
        "name": "Net Revenue",
        "table": "FactOnlineOrders",
        "expression": "[Total Revenue] - [Total Refunds] - [Total Discounts]",
        "formatString": "$#,0;($#,0)",
        "displayFolder": "Profitability"
      },
      {
        "name": "Store Transaction Count",
        "table": "FactPOSTransactions",
        "expression": "COUNTROWS(FactPOSTransactions)",
        "formatString": "#,0",
        "displayFolder": "Stores"
      },
      {
        "name": "Avg Transaction Value",
        "table": "FactPOSTransactions",
        "expression": "AVERAGE(FactPOSTransactions[SaleAmount])",
        "formatString": "$#,0.00",
        "displayFolder": "Stores"
      },
      {
        "name": "Revenue Per Sq Ft",
        "table": "FactPOSTransactions",
        "expression": "DIVIDE(SUM(FactPOSTransactions[SaleAmount]), SUM(DimStores[SquareFootage]))",
        "formatString": "$#,0.00",
        "displayFolder": "Stores"
      },
      {
        "name": "Store Count",
        "table": "DimStores",
        "expression": "COUNTROWS(DimStores)",
        "formatString": "#,0",
        "displayFolder": "Stores"
      },
      {
        "name": "Avg Footfall",
        "table": "FactStoreTraffic",
        "expression": "AVERAGE(FactStoreTraffic[FootfallCount])",
        "formatString": "#,0",
        "displayFolder": "Stores"
      },
      {
        "name": "Store Conversion Rate",
        "table": "FactStoreTraffic",
        "expression": "DIVIDE(SUM(FactStoreTraffic[ConversionCount]), SUM(FactStoreTraffic[FootfallCount]))",
        "formatString": "0.0%",
        "displayFolder": "Stores"
      },
      {
        "name": "Avg Dwell Time (min)",
        "table": "FactStoreTraffic",
        "expression": "AVERAGE(FactStoreTraffic[AvgDwellMinutes])",
        "formatString": "0.0",
        "displayFolder": "Stores"
      },
      {
        "name": "Total Footfall",
        "table": "FactStoreTraffic",
        "expression": "SUM(FactStoreTraffic[FootfallCount])",
        "formatString": "#,0",
        "displayFolder": "Stores"
      },
      {
        "name": "Employee Count",
        "table": "DimEmployees",
        "expression": "COUNTROWS(DimEmployees)",
        "formatString": "#,0",
        "displayFolder": "Stores"
      },
      {
        "name": "Revenue Per Employee",
        "table": "FactPOSTransactions",
        "expression": "DIVIDE(SUM(FactPOSTransactions[SaleAmount]), DISTINCTCOUNT(FactPOSTransactions[EmployeeID]))",
        "formatString": "$#,0.00",
        "displayFolder": "Stores"
      },
      {
        "name": "Total Inventory Value",
        "table": "FactInventorySnapshots",
        "expression": "SUMX(FactInventorySnapshots, FactInventorySnapshots[QuantityOnHand] * FactInventorySnapshots[UnitCost])",
        "formatString": "$#,0;($#,0)",
        "displayFolder": "Inventory"
      },
      {
        "name": "Total Qty On Hand",
        "table": "FactInventorySnapshots",
        "expression": "SUM(FactInventorySnapshots[QuantityOnHand])",
        "formatString": "#,0",
        "displayFolder": "Inventory"
      },
      {
        "name": "Inventory Turns",
        "table": "FactInventorySnapshots",
        "expression": "DIVIDE([COGS], [Total Inventory Value])",
        "formatString": "0.0",
        "displayFolder": "Inventory"
      },
      {
        "name": "GMROI",
        "table": "FactInventorySnapshots",
        "expression": "DIVIDE([Gross Profit], [Total Inventory Value])",
        "formatString": "0.00",
        "displayFolder": "Inventory"
      },
      {
        "name": "Sell-Through Rate",
        "table": "FactInventorySnapshots",
        "expression": "DIVIDE(SUM(FactOrderItems[Quantity]), SUM(FactOrderItems[Quantity]) + SUM(FactInventorySnapshots[QuantityOnHand]))",
        "formatString": "0.0%",
        "displayFolder": "Inventory"
      },
      {
        "name": "Avg Days of Supply",
        "table": "FactInventorySnapshots",
        "expression": "AVERAGE(FactInventorySnapshots[DaysOfSupply])",
        "formatString": "0.0",
        "displayFolder": "Inventory"
      },
      {
        "name": "Stockout Risk Items",
        "table": "FactInventorySnapshots",
        "expression": "CALCULATE(COUNTROWS(FactInventorySnapshots), FactInventorySnapshots[QuantityOnHand] <= FactInventorySnapshots[ReorderPoint])",
        "formatString": "#,0",
        "displayFolder": "Inventory"
      },
      {
        "name": "PO Count",
        "table": "FactPurchaseOrders",
        "expression": "COUNTROWS(FactPurchaseOrders)",
        "formatString": "#,0",
        "displayFolder": "Supply Chain"
      },
      {
        "name": "Total PO Value",
        "table": "FactPurchaseOrders",
        "expression": "SUM(FactPurchaseOrders[TotalAmount])",
        "formatString": "$#,0;($#,0)",
        "displayFolder": "Supply Chain"
      },
      {
        "name": "Avg Lead Time Days",
        "table": "DimSuppliers",
        "expression": "AVERAGE(DimSuppliers[LeadTimeDays])",
        "formatString": "0.0",
        "displayFolder": "Supply Chain"
      },
      {
        "name": "Supplier Quality Score",
        "table": "FactGoodsReceipts",
        "expression": "AVERAGE(FactGoodsReceipts[QualityScore])",
        "formatString": "0.0%",
        "displayFolder": "Supply Chain"
      },
      {
        "name": "On-Time Delivery %",
        "table": "FactGoodsReceipts",
        "expression": "DIVIDE(CALCULATE(COUNTROWS(FactGoodsReceipts), FactGoodsReceipts[DaysLate] <= 0), COUNTROWS(FactGoodsReceipts))",
        "formatString": "0.0%",
        "displayFolder": "Supply Chain"
      },
      {
        "name": "Damaged Goods Rate",
        "table": "FactGoodsReceipts",
        "expression": "DIVIDE(SUM(FactGoodsReceipts[QuantityDamaged]), SUM(FactGoodsReceipts[QuantityReceived]))",
        "formatString": "0.00%",
        "displayFolder": "Supply Chain"
      },
      {
        "name": "Avg Days Late",
        "table": "FactGoodsReceipts",
        "expression": "AVERAGE(FactGoodsReceipts[DaysLate])",
        "formatString": "0.0",
        "displayFolder": "Supply Chain"
      },
      {
        "name": "Total Marketing Spend",
        "table": "FactMarketingSpend",
        "expression": "SUM(FactMarketingSpend[AmountSpent])",
        "formatString": "$#,0;($#,0)",
        "displayFolder": "Marketing"
      },
      {
        "name": "Total Impressions",
        "table": "FactMarketingSpend",
        "expression": "SUM(FactMarketingSpend[Impressions])",
        "formatString": "#,0",
        "displayFolder": "Marketing"
      },
      {
        "name": "Total Clicks",
        "table": "FactMarketingSpend",
        "expression": "SUM(FactMarketingSpend[Clicks])",
        "formatString": "#,0",
        "displayFolder": "Marketing"
      },
      {
        "name": "CTR",
        "table": "FactMarketingSpend",
        "expression": "DIVIDE(SUM(FactMarketingSpend[Clicks]), SUM(FactMarketingSpend[Impressions]))",
        "formatString": "0.00%",
        "displayFolder": "Marketing"
      },
      {
        "name": "CPC",
        "table": "FactMarketingSpend",
        "expression": "DIVIDE(SUM(FactMarketingSpend[AmountSpent]), SUM(FactMarketingSpend[Clicks]))",
        "formatString": "$0.00",
        "displayFolder": "Marketing"
      },
      {
        "name": "Total Conversions",
        "table": "FactMarketingSpend",
        "expression": "SUM(FactMarketingSpend[Conversions])",
        "formatString": "#,0",
        "displayFolder": "Marketing"
      },
      {
        "name": "CAC",
        "table": "FactMarketingSpend",
        "expression": "DIVIDE(SUM(FactMarketingSpend[AmountSpent]), SUM(FactMarketingSpend[Conversions]))",
        "formatString": "$#,0.00",
        "displayFolder": "Marketing"
      },
      {
        "name": "ROAS",
        "table": "FactMarketingSpend",
        "expression": "DIVIDE(SUM(FactMarketingSpend[RevenueAttributed]), SUM(FactMarketingSpend[AmountSpent]))",
        "formatString": "0.00",
        "displayFolder": "Marketing"
      },
      {
        "name": "Campaign ROI",
        "table": "FactMarketingSpend",
        "expression": "DIVIDE(SUM(FactMarketingSpend[RevenueAttributed]) - SUM(FactMarketingSpend[AmountSpent]), SUM(FactMarketingSpend[AmountSpent]))",
        "formatString": "0.0%",
        "displayFolder": "Marketing"
      },
      {
        "name": "Marketing Revenue Attributed",
        "table": "FactMarketingSpend",
        "expression": "SUM(FactMarketingSpend[RevenueAttributed])",
        "formatString": "$#,0;($#,0)",
        "displayFolder": "Marketing"
      },
      {
        "name": "Budget Utilization %",
        "table": "FactMarketingSpend",
        "expression": "DIVIDE(SUM(FactMarketingSpend[AmountSpent]), SUM(DimCampaigns[Budget]))",
        "formatString": "0.0%",
        "displayFolder": "Marketing"
      },
      {
        "name": "Campaign Response Count",
        "table": "FactCampaignResponses",
        "expression": "COUNTROWS(FactCampaignResponses)",
        "formatString": "#,0",
        "displayFolder": "Marketing"
      },
      {
        "name": "Avg Review Rating",
        "table": "FactCustomerReviews",
        "expression": "AVERAGE(FactCustomerReviews[Rating])",
        "formatString": "0.0",
        "displayFolder": "Customer"
      },
      {
        "name": "NPS Proxy",
        "table": "FactCustomerReviews",
        "expression": "DIVIDE(CALCULATE(COUNTROWS(FactCustomerReviews), FactCustomerReviews[Rating] >= 4), COUNTROWS(FactCustomerReviews)) - DIVIDE(CALCULATE(COUNTROWS(FactCustomerReviews), FactCustomerReviews[Rating] <= 2), COUNTROWS(FactCustomerReviews))",
        "formatString": "0.0%",
        "displayFolder": "Customer"
      },
      {
        "name": "Avg Sentiment Score",
        "table": "FactCustomerReviews",
        "expression": "AVERAGE(FactCustomerReviews[SentimentScore])",
        "formatString": "0.00",
        "displayFolder": "Customer"
      },
      {
        "name": "Verified Review %",
        "table": "FactCustomerReviews",
        "expression": "DIVIDE(CALCULATE(COUNTROWS(FactCustomerReviews), FactCustomerReviews[IsVerifiedPurchase] = TRUE()), COUNTROWS(FactCustomerReviews))",
        "formatString": "0.0%",
        "displayFolder": "Customer"
      },
      {
        "name": "Review Count",
        "table": "FactCustomerReviews",
        "expression": "COUNTROWS(FactCustomerReviews)",
        "formatString": "#,0",
        "displayFolder": "Customer"
      },
      {
        "name": "Total Points Earned",
        "table": "FactLoyaltyPoints",
        "expression": "SUM(FactLoyaltyPoints[PointsEarned])",
        "formatString": "#,0",
        "displayFolder": "Customer"
      },
      {
        "name": "Total Points Redeemed",
        "table": "FactLoyaltyPoints",
        "expression": "SUM(FactLoyaltyPoints[PointsRedeemed])",
        "formatString": "#,0",
        "displayFolder": "Customer"
      },
      {
        "name": "Redemption Rate",
        "table": "FactLoyaltyPoints",
        "expression": "DIVIDE(SUM(FactLoyaltyPoints[PointsRedeemed]), SUM(FactLoyaltyPoints[PointsEarned]))",
        "formatString": "0.0%",
        "displayFolder": "Customer"
      },
      {
        "name": "Active Loyalty Members",
        "table": "FactLoyaltyPoints",
        "expression": "DISTINCTCOUNT(FactLoyaltyPoints[CustomerID])",
        "formatString": "#,0",
        "displayFolder": "Customer"
      },
      {
        "name": "Repeat Purchase Rate",
        "table": "FactOnlineOrders",
        "expression": "DIVIDE(CALCULATE(COUNTROWS(VALUES(FactOnlineOrders[CustomerID])), COUNTROWS(FactOnlineOrders) > 1), DISTINCTCOUNT(FactOnlineOrders[CustomerID]))",
        "formatString": "0.0%",
        "displayFolder": "Customer"
      },
      {
        "name": "Unique Customers",
        "table": "FactOnlineOrders",
        "expression": "DISTINCTCOUNT(FactOnlineOrders[CustomerID])",
        "formatString": "#,0",
        "displayFolder": "Customer"
      },
      {
        "name": "CLV Estimate",
        "table": "FactOnlineOrders",
        "expression": "DIVIDE(SUM(FactOnlineOrders[OrderTotal]), DISTINCTCOUNT(FactOnlineOrders[CustomerID])) * 3",
        "formatString": "$#,0.00",
        "displayFolder": "Customer"
      },
      {
        "name": "Product Count",
        "table": "DimProducts",
        "expression": "COUNTROWS(DimProducts)",
        "formatString": "#,0",
        "displayFolder": "Product"
      },
      {
        "name": "Active Product Count",
        "table": "DimProducts",
        "expression": "CALCULATE(COUNTROWS(DimProducts), DimProducts[IsActive] = TRUE())",
        "formatString": "#,0",
        "displayFolder": "Product"
      },
      {
        "name": "Supplier Count",
        "table": "DimSuppliers",
        "expression": "COUNTROWS(DimSuppliers)",
        "formatString": "#,0",
        "displayFolder": "Product"
      },
      {
        "name": "Avg Supplier Rating",
        "table": "DimSuppliers",
        "expression": "AVERAGE(DimSuppliers[Rating])",
        "formatString": "0.0",
        "displayFolder": "Product"
      },
      {
        "name": "Preferred Supplier %",
        "table": "DimSuppliers",
        "expression": "DIVIDE(CALCULATE(COUNTROWS(DimSuppliers), DimSuppliers[IsPreferred] = TRUE()), COUNTROWS(DimSuppliers))",
        "formatString": "0.0%",
        "displayFolder": "Product"
      },
      {
        "name": "Online Channel Mix %",
        "table": "FactOnlineOrders",
        "expression": "DIVIDE(SUM(FactOnlineOrders[OrderTotal]), [Total Revenue])",
        "formatString": "0.0%",
        "displayFolder": "Revenue"
      },
      {
        "name": "Store Channel Mix %",
        "table": "FactPOSTransactions",
        "expression": "DIVIDE(SUM(FactPOSTransactions[SaleAmount]), [Total Revenue])",
        "formatString": "0.0%",
        "displayFolder": "Revenue"
      },
      {
        "name": "Revenue Per Store",
        "table": "FactPOSTransactions",
        "expression": "DIVIDE(SUM(FactPOSTransactions[SaleAmount]), COUNTROWS(DimStores))",
        "formatString": "$#,0;($#,0)",
        "displayFolder": "Stores"
      },
      {
        "name": "Warehouse Count",
        "table": "DimWarehouses",
        "expression": "COUNTROWS(DimWarehouses)",
        "formatString": "#,0",
        "displayFolder": "Inventory"
      },
      {
        "name": "CPM",
        "table": "FactMarketingSpend",
        "expression": "DIVIDE(SUM(FactMarketingSpend[AmountSpent]), SUM(FactMarketingSpend[Impressions])) * 1000",
        "formatString": "$0.00",
        "displayFolder": "Marketing"
      },
      {
        "name": "Total Campaign Budget",
        "table": "DimCampaigns",
        "expression": "SUM(DimCampaigns[Budget])",
        "formatString": "$#,0;($#,0)",
        "displayFolder": "Marketing"
      },
      {
        "name": "Active Campaigns",
        "table": "DimCampaigns",
        "expression": "CALCULATE(COUNTROWS(DimCampaigns), DimCampaigns[Status] = \"Active\")",
        "formatString": "#,0",
        "displayFolder": "Marketing"
      },
      {
        "name": "Segment Count",
        "table": "DimCustomerSegments",
        "expression": "COUNTROWS(DimCustomerSegments)",
        "formatString": "#,0",
        "displayFolder": "Customer"
      },
      {
        "name": "Avg Retention Rate",
        "table": "DimCustomerSegments",
        "expression": "AVERAGE(DimCustomerSegments[RetentionRate])",
        "formatString": "0.0%",
        "displayFolder": "Customer"
      },
      {
        "name": "Avg Discount %",
        "table": "FactOrderItems",
        "expression": "AVERAGE(FactOrderItems[DiscountPct])",
        "formatString": "0.0%",
        "displayFolder": "E-Commerce"
      },
      {
        "name": "Revenue by Website",
        "table": "FactOnlineOrders",
        "expression": "CALCULATE(SUM(FactOnlineOrders[OrderTotal]), FactOnlineOrders[Channel] = \"Website\")",
        "formatString": "$#,0;($#,0)",
        "displayFolder": "E-Commerce"
      },
      {
        "name": "Revenue by Mobile App",
        "table": "FactOnlineOrders",
        "expression": "CALCULATE(SUM(FactOnlineOrders[OrderTotal]), FactOnlineOrders[Channel] = \"Mobile App\")",
        "formatString": "$#,0;($#,0)",
        "displayFolder": "E-Commerce"
      },
      {
        "name": "Store POS Discount Total",
        "table": "FactPOSTransactions",
        "expression": "SUM(FactPOSTransactions[DiscountApplied])",
        "formatString": "$#,0;($#,0)",
        "displayFolder": "Stores"
      },
      {
        "name": "Avg PO Value",
        "table": "FactPurchaseOrders",
        "expression": "AVERAGE(FactPurchaseOrders[TotalAmount])",
        "formatString": "$#,0.00",
        "displayFolder": "Supply Chain"
      },
      {
        "name": "Received PO %",
        "table": "FactPurchaseOrders",
        "expression": "DIVIDE(CALCULATE(COUNTROWS(FactPurchaseOrders), FactPurchaseOrders[POStatus] = \"Received\"), COUNTROWS(FactPurchaseOrders))",
        "formatString": "0.0%",
        "displayFolder": "Supply Chain"
      },
      {
        "name": "Line Total Revenue",
        "table": "FactOrderItems",
        "expression": "SUM(FactOrderItems[LineTotal])",
        "formatString": "$#,0;($#,0)",
        "displayFolder": "E-Commerce"
      },
      {
        "name": "Avg Line Item Value",
        "table": "FactOrderItems",
        "expression": "AVERAGE(FactOrderItems[LineTotal])",
        "formatString": "$#,0.00",
        "displayFolder": "E-Commerce"
      },
      {
        "name": "Top Return Reason",
        "table": "FactReturns",
        "expression": "TOPN(1, VALUES(FactReturns[ReturnReason]), CALCULATE(COUNTROWS(FactReturns)))",
        "formatString": "",
        "displayFolder": "Returns"
      }
    ]
  }
}
