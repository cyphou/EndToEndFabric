    {
      "name": "HorizonBooks-Pipeline",
      "theme": {
        "primary": "#1B3A5C",
        "secondary": "#E8A838",
        "background": "#FAFAFA"
      },
      "pages": [
        {
          "name": "Pipeline Overview",
          "visuals": [
            {
              "type": "card",
              "measure": "Total Tables Loaded"
            },
            {
              "type": "card",
              "measure": "Total Rows Ingested"
            },
            {
              "type": "card",
              "measure": "Last Refresh Time"
            },
            {
              "type": "card",
              "measure": "Pipeline Success Rate"
            },
            {
              "type": "clusteredBarChart",
              "axis": "Domain",
              "values": [
                "Tables Loaded",
                "Rows Ingested"
              ]
            },
            {
              "type": "table",
              "columns": [
                "Pipeline Step",
                "Status",
                "Duration (s)",
                "Rows Processed"
              ]
            }
          ]
        },
        {
          "name": "Data Quality",
          "visuals": [
            {
              "type": "card",
              "measure": "Data Quality Score"
            },
            {
              "type": "card",
              "measure": "Null Value Count"
            },
            {
              "type": "card",
              "measure": "Duplicate Row Count"
            },
            {
              "type": "clusteredBarChart",
              "axis": "TableName",
              "values": [
                "Null %",
                "Duplicate %"
              ]
            },
            {
              "type": "table",
              "columns": [
                "TableName",
                "TotalRows",
                "NullCount",
                "DuplicateCount",
                "QualityScore"
              ]
            }
          ]
        },
        {
          "name": "Ingestion by Domain",
          "visuals": [
            {
              "type": "donutChart",
              "legend": "Domain",
              "values": [
                "Rows Ingested"
              ]
            },
            {
              "type": "stackedBarChart",
              "axis": "Domain",
              "values": [
                "CSV Files",
                "Tables Created"
              ]
            },
            {
              "type": "table",
              "columns": [
                "Domain",
                "Dataflow",
                "CSV Files",
                "Tables",
                "Last Run"
              ]
            }
          ]
        },
        {
          "name": "Refresh History",
          "visuals": [
            {
              "type": "lineChart",
              "axis": "RefreshDate",
              "values": [
                "Duration (s)",
                "Rows Processed"
              ]
            },
            {
              "type": "table",
              "columns": [
                "RefreshDate",
                "Pipeline",
                "Status",
                "Duration (s)",
                "Error"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "HorizonBooks-Writeback",
      "semanticModel": "writeback",
      "theme": {
        "primary": "#6A1B9A",
        "secondary": "#FF6F00",
        "background": "#FAFAFA"
      },
      "pages": [
        {
          "name": "Sales Targets",
          "visuals": [
            {
              "type": "card",
              "measure": "Total Target Revenue"
            },
            {
              "type": "card",
              "measure": "Total Target Units Sold"
            },
            {
              "type": "table",
              "columns": [
                "TargetId",
                "FiscalYear",
                "FiscalQuarter",
                "Imprint",
                "Genre",
                "TargetRevenue",
                "TargetUnitsSold",
                "ModifiedBy"
              ]
            },
            {
              "type": "clusteredBarChart",
              "axis": "Imprint",
              "values": [
                "TargetRevenue"
              ]
            }
          ]
        },
        {
          "name": "Inventory Overrides",
          "visuals": [
            {
              "type": "table",
              "columns": [
                "OverrideId",
                "WarehouseId",
                "ISBN",
                "OverrideQty",
                "ReasonCode",
                "EffectiveDate",
                "ModifiedBy"
              ]
            },
            {
              "type": "clusteredBarChart",
              "axis": "ReasonCode",
              "values": [
                "OverrideQty"
              ]
            }
          ]
        },
        {
          "name": "Royalty Adjustments",
          "visuals": [
            {
              "type": "card",
              "measure": "Pending Count"
            },
            {
              "type": "table",
              "columns": [
                "AdjustmentId",
                "AuthorId",
                "ContractYear",
                "CurrentRate",
                "ProposedRate",
                "Status",
                "SubmittedBy"
              ]
            },
            {
              "type": "clusteredBarChart",
              "axis": "Status",
              "values": [
                "ProposedRate"
              ]
            }
          ]
        }
      ]
    }
  ]
